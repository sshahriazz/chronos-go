{
  "uid": "chronos-authz",
  "title": "Chronos \u2014 Authorization (OpenFGA)",
  "description": "Every access decision in the system. If a permission question is being answered anywhere else (a SQL join, a Go loop), that is a bug.",
  "tags": [
    "chronos",
    "openfga",
    "authorization"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Request path",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "gRPC calls by method",
      "description": "Check and BatchCheck should dominate. A high ListObjects rate on the request path usually means a screen is asking the wrong question.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "sum(rate(grpc_server_started_total{job=\"openfga\"}[5m])) by (grpc_method)",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{grpc_method}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Errors / sec",
      "description": "Non-OK gRPC responses. Note: unauthenticated calls count here.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "sum(rate(grpc_server_handled_total{job=\"openfga\",grpc_code!=\"OK\"}[5m])) or vector(0)",
          "refId": "B",
          "format": "time_series"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Goroutines",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "go_goroutines{job=\"openfga\"}",
          "refId": "C",
          "format": "time_series"
        }
      ]
    },
    {
      "type": "row",
      "title": "Cache \u2014 the difference between fast and slow authorization",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Check cache hit ratio",
      "description": "Cold cache means every Check walks the graph in PostgreSQL.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "rate(openfga_check_cache_hit_count[5m]) / clamp_min(rate(openfga_check_cache_total_count[5m]), 1)",
          "refId": "D",
          "format": "time_series",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache activity",
      "description": "Invalidations spike after WriteTuples \u2014 expected right after a share.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "rate(openfga_check_cache_total_count[5m])",
          "refId": "E",
          "format": "time_series",
          "legendFormat": "lookups/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "rate(openfga_check_cache_hit_count[5m])",
          "refId": "F",
          "format": "time_series",
          "legendFormat": "hits/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "rate(openfga_cachecontroller_cache_invalidation_count[5m])",
          "refId": "G",
          "format": "time_series",
          "legendFormat": "invalidations/s"
        }
      ]
    },
    {
      "type": "row",
      "title": "Conditions (ABAC)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Condition evaluation p95",
      "description": "CEL expression cost \u2014 this is where 'share expires in 7 days' is enforced.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(openfga_condition_evaluation_duration_ms_bucket[5m])) by (le))",
          "refId": "H",
          "format": "time_series",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Iterators in flight",
      "description": "Graph-walk iterators. Growth without bound means a query is fanning out.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "openfga_shared_iterator_count",
          "refId": "I",
          "format": "time_series",
          "legendFormat": "shared iterators"
        }
      ]
    },
    {
      "type": "row",
      "title": "Traces \u2014 OpenFGA is the only component emitting OTLP without a licence",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Span rate by service",
      "description": "Generated by Tempo's metrics-generator from received spans. Go services appear here automatically once they export OTLP.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "sum(rate(traces_spanmetrics_calls_total[5m])) by (service)",
          "refId": "J",
          "format": "time_series",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Span latency p95 by service",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket[5m])) by (le, service))",
          "refId": "K",
          "format": "time_series",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
