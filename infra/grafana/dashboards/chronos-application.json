          "format": "time_series",
          "legendFormat": "{{projection}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Events applied",
      "description": "Applied per second. A projection at zero while others move is either filtered to a quiet module or stuck.",
