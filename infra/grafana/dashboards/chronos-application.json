      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Live",
      "description": "1 = caught up. This is the metric to alert on.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
