{
  "uid": "chronos-eventlog",
  "title": "Chronos \u2014 Event Log (KurrentDB)",
  "description": "The single source of truth. Index lag is the metric that matters most: it bounds how stale every PostgreSQL read model can be.",
  "tags": [
    "chronos",
    "kurrentdb",
    "event-sourcing"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Ingest",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Event throughput",
      "description": "Writes are appends from the Go API. Reads are dominated by projector catch-up subscriptions.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "sum(rate(kurrentdb_io_events_total[5m])) by (activity)",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{activity}}"
        }
      ]
    },
