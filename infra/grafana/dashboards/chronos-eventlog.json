    {
      "type": "timeseries",
      "title": "Secondary index lag",
      "description": "Time between a record being appended and being indexed. If this climbs, read models fall behind writes.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
