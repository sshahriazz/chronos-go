{
  "uid": "chronos-storage",
  "title": "Chronos \u2014 Storage & Data",
  "description": "PostgreSQL stores what a resource is, SeaweedFS stores its bytes, Mailpit catches everything the app tries to email.",
  "tags": [
    "chronos",
    "postgres",
    "seaweedfs",
    "mailpit"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "PostgreSQL \u2014 read model + OpenFGA + Temporal",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connections by database",
      "description": "Four databases share one server: chronos, openfga, temporal, temporal_visibility.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "sum(pg_stat_activity_count) by (datname)",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Transaction rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "sum(rate(pg_stat_database_xact_commit[5m])) by (datname)",
          "refId": "B",
          "format": "time_series",
          "legendFormat": "{{datname}} commit"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "sum(rate(pg_stat_database_xact_rollback[5m])) by (datname)",
          "refId": "C",
          "format": "time_series",
          "legendFormat": "{{datname}} rollback"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Below ~0.95 sustained means shared_buffers is too small for the working set.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "sum(rate(pg_stat_database_blks_hit[5m])) by (datname) / clamp_min(sum(rate(pg_stat_database_blks_hit[5m]) + rate(pg_stat_database_blks_read[5m])) by (datname), 1)",
          "refId": "D",
          "format": "time_series",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database size",
      "description": "A read model that outgrows the event log usually means a projection is storing derived data it could recompute.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
