    {
      "type": "timeseries",
      "title": "What happened? \u2014 KurrentDB event I/O",
      "description": "Events read from and written to the log. The write line is the true ingest rate of the whole system.",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "sum(rate(kurrentdb_io_events_total[5m])) by (activity)",
          "refId": "M",
          "format": "time_series",
          "legendFormat": "{{activity}}"
        }
      ]
    },
