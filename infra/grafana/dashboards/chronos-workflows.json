{
  "uid": "chronos-workflows",
  "title": "Chronos \u2014 Workflows (Temporal)",
  "description": "Durable execution. Backlog age and scheduled-queue lag are the two numbers that show up as user-visible delay.",
  "tags": [
    "chronos",
    "temporal",
    "workflows"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Service",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate by operation",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "chronos-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "chronos-prometheus"
          },
          "expr": "sum(rate(service_requests{job=\"temporal\"}[5m])) by (operation)",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "type": "timeseries",
