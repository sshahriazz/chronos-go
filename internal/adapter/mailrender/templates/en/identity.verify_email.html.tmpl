{{define "title"}}Verify your email address{{end}}
{{define "content"}}
{{/*
  The link is built HERE rather than passed in, from the base URL the renderer
  already holds. One place knows how to turn a token into a URL, and the token
  never has to be concatenated into a string in Go — where a log line, an error
  message or a span attribute could pick it up on the way past.
*/}}
{{$link := url (printf "/verify-email?token=%s" .Token)}}
<p style="margin:0 0 14px;">Hello{{if .Name}} {{.Name}}{{end}},</p>
<p style="margin:0 0 20px;">Confirm that this address belongs to you to finish setting up your Chronos account.</p>
<p style="margin:0 0 20px;">
  <a href="{{$link}}" style="display:inline-block;background:#1a1d21;color:#ffffff;text-decoration:none;padding:11px 20px;border-radius:6px;font-size:14px;font-weight:500;">Verify email address</a>
</p>
<p style="margin:0 0 14px;color:#6b7280;font-size:13px;">If the button does not work, paste this into your browser:<br>
  <a href="{{$link}}" style="color:#3b5bdb;word-break:break-all;">{{$link}}</a>
</p>
<p style="margin:0 0 6px;color:#6b7280;font-size:13px;">This link expires in {{.ExpiresIn}} and can be used once.</p>
<p style="margin:0;color:#6b7280;font-size:13px;">If you did not create a Chronos account, ignore this message — nothing was activated, and the address is released when the link expires.</p>
{{end}}
