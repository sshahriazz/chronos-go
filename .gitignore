# secrets / local config
.env
*.local

# go
/bin/
/dist/
*.test
*.out
/vendor/

# editors
.idea/
.vscode/
.DS_Store
# 42Crunch OpenAPI audit, a VS Code extension's local scan output
/.42c/

# local code index (rebuildable via `codegraph index`)
/.codegraph/

# local data escaping a bind mount
/data/
bin/

# Stray `go build -o <name> ./cmd/<name>` output. The binaries are built into
# ./bin or run with `go run`; a 50 MB executable at the repo root is always an
# accident, and it shows up in the gate as an untracked file.
#
# Listed by name rather than by a pattern: a bare `/apidocs` glob would be a
# guess, while every entry here is a real main package in this tree, and a
# pattern loose enough to catch them all would also hide a directory somebody
# meant to add.
/api
/apidocs
/migrate
/projector
/worker

# internal/tools — same thing, one binary per generator and gate.
/checkdashboards
/checkopenapi
/fixopenapi
/gendashboards
/gendocs
/obsprobe

# Google OAuth client secrets, as the Cloud Console exports them.
#
# The download carries a LIVE client secret. It is ignored by pattern rather
# than by name so the next one somebody downloads is ignored too — a rule that
# only covers the file you already noticed is a rule that fails the second time.
client_secret_*.apps.googleusercontent.com.json

# OpenBao's unseal key and root token for local development.
#
# It sits beside the data it unseals, which production must never do and a
# laptop needs. Losing it makes the local vault unreadable; committing it would
# publish the key that protects every local account's personal data.
infra/openbao/.bao-credentials.json
