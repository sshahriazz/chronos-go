# =============================================================================
# Chronos — local infrastructure environment
# Copy to .env and edit. .env is gitignored; .env.example is committed.
# =============================================================================

COMPOSE_PROJECT_NAME=chronos

# -----------------------------------------------------------------------------
# Image pins — see docs/INFRA.md §9 for the licence/version matrix
# -----------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:18.4
VALKEY_IMAGE=valkey/valkey:9.1.1-alpine
OPENFGA_IMAGE=openfga/openfga:v1.18.3
CENTRIFUGO_IMAGE=centrifugo/centrifugo:v6.9.1
TEMPORAL_IMAGE=temporalio/auto-setup:1.29.7
TEMPORAL_UI_IMAGE=temporalio/ui:2.53.1
TEMPORAL_ADMINTOOLS_IMAGE=temporalio/admin-tools:1.29.7-tctl-1.18.4-cli-1.7.2
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.41
MAILPIT_IMAGE=axllent/mailpit:v1.30.6
OPENBAO_IMAGE=openbao/openbao:2.6.1
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2
GRAFANA_IMAGE=grafana/grafana:13.1.3
TEMPO_IMAGE=grafana/tempo:2.9.4
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.158.0
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.20.1
VALKEY_EXPORTER_IMAGE=oliver006/redis_exporter:v1.88.0-alpine

# KurrentDB: 26.1.2 is the current stable (GA) release. 26.0.x is the LTS line
# if you prefer a slower-moving pin.
#
# Kurrent ships NO stable arm64 build — every arm64 tag they publish is labelled
# `-experimental-arm64-*` by the vendor. So we run the stable x86_64 build under
# Docker Desktop's emulation instead of shipping a vendor-experimental binary.
# Everything else in the stack is native multi-arch.
#
# On an x86_64 host, KURRENTDB_PLATFORM is a harmless no-op.
# To trade stability for native speed on Apple Silicon, swap to
# `26.1.2-experimental-arm64-10.0-noble` and set KURRENTDB_PLATFORM=linux/arm64.
KURRENTDB_IMAGE=kurrentplatform/kurrentdb:26.1.2
KURRENTDB_PLATFORM=linux/amd64

# -----------------------------------------------------------------------------
# PostgreSQL — read model + OpenFGA + Temporal backing store
# -----------------------------------------------------------------------------
# Owner / migration credentials (superuser — migrations only)
POSTGRES_USER=chronos
POSTGRES_PASSWORD=chronos_dev_password
# Application credentials. MUST NOT be a superuser: superusers bypass RLS.
POSTGRES_APP_USER=chronos_app
POSTGRES_APP_PASSWORD=chronos_app_dev_password

# The OPERATOR plane's role (ADR-024). Created by migration 00037, granted the
# six operator_* tables plus SELECT on the PII vault, and REVOKED from every
# tenant table — so a bug in operator code cannot reach customer content because
# the grant does not exist.
#
# Only cmd/operator uses these. Every other binary must start without them,
# which is why they are not `required`; cmd/operator refuses to start without a
# password rather than falling back to chronos_app, because falling back would
# hand the operator plane exactly the grants the separation withholds.
POSTGRES_OPERATOR_USER=chronos_operator
POSTGRES_OPERATOR_PASSWORD=chronos_operator_dev_password
POSTGRES_DB=chronos
POSTGRES_PORT=5432

# Atlas / sqlc. DATABASE_DEV_URL is a scratch database used to compute diffs.
DATABASE_URL=postgres://chronos:chronos_dev_password@localhost:5432/chronos?sslmode=disable
DATABASE_DEV_URL=postgres://chronos:chronos_dev_password@localhost:5432/chronos_atlas_dev?sslmode=disable

# Databases created by infra/postgres/init/ on first boot
OPENFGA_DB=openfga
TEMPORAL_DB=temporal
TEMPORAL_VISIBILITY_DB=temporal_visibility

# -----------------------------------------------------------------------------
# KurrentDB — event log
# -----------------------------------------------------------------------------
KURRENTDB_PORT=2113

# -----------------------------------------------------------------------------
# OpenFGA — authorization graph
# -----------------------------------------------------------------------------
OPENFGA_HTTP_PORT=8080
OPENFGA_GRPC_PORT=8081
OPENFGA_METRICS_PORT=2112
# Dev-only pre-shared key. Rotate for anything shared.
OPENFGA_PRESHARED_KEY=chronos_dev_openfga_key
# The playground is DISABLED and its port is not published. It cannot run
# alongside authentication — OpenFGA panics at startup with
# "the playground only supports authn method 'none'". Use the OpenFGA HTTP API,
# the `fga` CLI, or a Grafana panel instead.
OPENFGA_AUTHN_METHOD=preshared
OPENFGA_PLAYGROUND_ENABLED=false

# -----------------------------------------------------------------------------
# Valkey — sessions, rate limiting, Centrifugo backplane
# -----------------------------------------------------------------------------
VALKEY_PORT=6379

# -----------------------------------------------------------------------------
# Centrifugo — realtime edge
# -----------------------------------------------------------------------------
CENTRIFUGO_PORT=8000
CENTRIFUGO_GRPC_PORT=10000
# HMAC key the Go API signs connection/subscription JWTs with.
CENTRIFUGO_TOKEN_HMAC_SECRET=chronos_dev_centrifugo_token_secret
# X-API-Key required to call the server publish API.
CENTRIFUGO_API_KEY=chronos_dev_centrifugo_api_key
CENTRIFUGO_ADMIN_PASSWORD=chronos_dev_admin
CENTRIFUGO_ADMIN_SECRET=chronos_dev_admin_secret

# -----------------------------------------------------------------------------
# Temporal — durable workflows
# -----------------------------------------------------------------------------
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_METRICS_PORT=9091
TEMPORAL_NAMESPACE=default

# Durable work (ADR-017): effects that span several steps, need timers, or must
# survive the worker dying halfway. Off by default — a binary that dials a
# service it never uses reports a DOWN probe for a dependency nothing needs.
#
# When on, cmd/worker builds a client AND starts a worker that registers the
# workflows. Both halves or neither: a starter without a worker creates runs
# that sit in a queue nothing polls, and the caller is told they started.
TEMPORAL_ENABLED=false
TEMPORAL_HOSTPORT=localhost:7233

# The task queue starters write to and workers poll. Both sides must agree —
# work queued where no worker listens is created and then never runs. It is also
# the versioning boundary: a workflow change that is not replay-safe moves to a
# new queue rather than breaking in-flight executions.
TEMPORAL_TASK_QUEUE=chronos

# -----------------------------------------------------------------------------
# SeaweedFS — S3 object storage
# -----------------------------------------------------------------------------
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_METRICS_PORT=9327
# gRPC. SeaweedFS convention: gRPC port = HTTP port + 10000.
SEAWEEDFS_MASTER_GRPC_PORT=19333
SEAWEEDFS_FILER_GRPC_PORT=18888
SEAWEEDFS_S3_GRPC_PORT=18333
# Must match infra/seaweedfs/s3.json
S3_ACCESS_KEY=chronos
S3_SECRET_KEY=chronos-secret-key
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=chronos

# -----------------------------------------------------------------------------
# Mailpit — SMTP capture (development only)
# -----------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@chronos.local

# -----------------------------------------------------------------------------
# OpenBao — key custody (ADR-028)
# DEV MODE: in-memory, auto-unsealed, fixed root token. Production runs sealed
# with persistent storage and a real unseal procedure.
# -----------------------------------------------------------------------------
OPENBAO_PORT=8200
OPENBAO_DEV_TOKEN=chronos_dev_root_token
OPENBAO_ADDR=http://localhost:8200
# Transit key that wraps per-subject data keys
OPENBAO_KEK_NAME=chronos-kek

# KV v2 engine holding APPLICATION secrets — a different job from the KEK above.
# That key never leaves OpenBao; these values must, because a Stripe key is
# useless unless the process can send it to Stripe. This is CUSTODY: read once
# at startup over an authenticated channel, instead of sitting in every
# process's environment where it appears in `docker inspect`, in a crash dump
# and in the deploying shell's history (BILLING-PLAN.md §7).
OPENBAO_KV_MOUNT=secret

# Where the Stripe secrets live in that mount. EMPTY MEANS "not in custody",
# and that is the switch:
#
#   unset  the STRIPE_* variables below are used, which is what a dev machine
#          wants and why .env exists at all
#   set    OpenBao is AUTHORITATIVE. A missing api_key is a startup failure,
#          never a silent fall back to the environment — a fallback makes a
#          rotation that failed to land look exactly like one that worked
#
# `make up` seeds this path from the STRIPE_* values below, for development
# only. In production nothing seeds anything: whoever holds the secrets writes
# them, and startup finds them already there.
#
# Commented out by default so a fresh clone works with no OpenBao round trip.
# OPENBAO_STRIPE_PATH=chronos/stripe

# -----------------------------------------------------------------------------
# Telemetry — Prometheus scrapes every component; Grafana visualises it.
# PostgreSQL and Valkey speak no HTTP, so they get sidecar exporters.
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
POSTGRES_EXPORTER_PORT=9187
VALKEY_EXPORTER_PORT=9121
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=chronos_dev_grafana

# Tracing. Go services send OTLP to the collector, never to Tempo directly:
# sampling and attribute scrubbing live in infra/otel-collector/config.yaml, and
# a service exporting straight to the backend would bypass both.
#
# Off by default, like every other outbound dependency — a binary that dials a
# collector nobody is running logs reconnect noise for no benefit. Turning it ON
# also changes what is written to the EVENT LOG: with a span present, an event's
# correlation id becomes the trace id, so a span in Tempo and an event line up
# with no join table. The W3C propagator is installed either way, so that
# behaviour does not depend on whether this process exports anything.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---------------------------------------------------------------------------
# Profiling (pprof)
# ---------------------------------------------------------------------------
#
# The Go runtime profiler over HTTP, on its OWN listener — never the API port.
# Go 1.27 added /debug/pprof/goroutineleak to the set, which reports goroutines
# blocked on concurrency primitives nothing can reach again; heap, allocs, CPU,
# block, mutex and the execution trace are there too.
#
# OFF by default, and that is a security default rather than a performance one.
# /debug/pprof/heap returns live heap contents and /debug/pprof/goroutine returns
# every goroutine's stack WITH ARGUMENTS, so an open pprof port hands out session
# tokens, email addresses and decrypted data keys — the three things ADR-002
# exists to keep out of everything else in this system.
#
# The rules cmd/api refuses to boot against:
#
#   - a non-loopback PPROF_ADDR with no PPROF_TOKEN, in ANY environment
#   - PPROF_ENABLED=true outside local with no PPROF_TOKEN, loopback or not,
#     because a container's loopback is shared by every process in the pod
#   - a PPROF_TOKEN shorter than 32 characters
#
# The port is deliberately NOT published in docker-compose.yml. Reaching it in a
# cluster is a port-forward; reaching it locally is `go tool pprof
# http://localhost:6060/debug/pprof/heap`.
PPROF_ENABLED=false
PPROF_ADDR=127.0.0.1:6060
# PPROF_TOKEN=  # required for any non-loopback bind, and outside local always

OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_COLLECTOR_METRICS_PORT=8889
TEMPO_PORT=3200

# Go services
API_PORT=8090
# API documentation server (make docs-serve)
DOCS_PORT=8091
# Interactive gRPC console (make grpc-ui)
GRPCUI_PORT=8092
# Projector health endpoint (make projector)
PROJECTOR_PORT=8093
# Worker (reactor) health endpoint (make worker)
WORKER_PORT=8094

# ---- Outbound mail -----------------------------------------------------------
# Mailpit in development: no auth, no TLS, and nothing ever leaves the machine.
# SMTP_STARTTLS is REQUIRED outside local — cmd/* refuses to start without it.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
MAIL_FROM_NAME=Chronos
MAIL_FROM_ADDRESS=no-reply@chronos.local
MAIL_BASE_URL=http://localhost:3000
# Receives Operator-class alerts (stopped projection, parked backlog). Never
# receives tenant mail.
MAIL_OPERATOR_ADDRESS=ops@chronos.local
MAIL_DEFAULT_LOCALE=en

# ---- Object storage ----------------------------------------------------------
# User bytes NEVER pass through the Go server: the browser uploads straight to
# SeaweedFS using a signed POST policy, and the server records a reference.
# Every limit below is enforced by the storage service before anything is
# stored — verified: a body over the policy limit is rejected with
# EntityTooLarge (400).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=chronos
# The address a BROWSER can reach. Differs from S3_ENDPOINT whenever storage is
# behind a container network or a CDN; wrong here means grants that work from
# the server and fail from every browser.
S3_PUBLIC_ENDPOINT=http://localhost:8333

STORAGE_MAX_UPLOAD_BYTES=104857600
STORAGE_MAX_BATCH_COUNT=20
# At or above this, clients use resumable (multipart) upload. Must be >= the
# part size, or a resumable upload could be one undersized part.
STORAGE_RESUMABLE_THRESHOLD_BYTES=8388608
STORAGE_PART_SIZE_BYTES=8388608
STORAGE_GRANT_EXPIRY=15m
# Empty permits any type. Set it for anything users upload.
STORAGE_ALLOWED_CONTENT_TYPES=

# ---- Realtime ----------------------------------------------------------------
# gRPC rather than the HTTP API — chosen on measurement, not preference; the
# numbers are recorded in internal/adapter/centrifugo/publisher.go.
CENTRIFUGO_GRPC_ENDPOINT=localhost:10000
# TWO DIFFERENT SECRETS, and confusing them is the classic mistake:
#   CENTRIFUGO_API_KEY            authenticates OUR server publishes
#   CENTRIFUGO_TOKEN_HMAC_SECRET  signs tokens BROWSERS present
# Swapping them gives a server that cannot publish and browsers that cannot
# connect — two failures with one cause. Both already set above.
# Addresses the api binary dials (container names in compose, localhost here)
KURRENTDB_HTTP_URL=http://localhost:2113
VALKEY_ADDR=localhost:6379
# Empty in development: Valkey listens only on the compose network.
VALKEY_PASSWORD=
OPENFGA_ENDPOINT=localhost:8081

# The store and model the checker uses. BOTH are produced by `make authz-deploy`,
# which provisions the store and deploys the authorization model.
#
# Blank OPENFGA_STORE_ID means the checker is not constructed at all, and the
# server says so at startup: "openfga checker not constructed; EVERY permission
# check will be denied". That is the deliberate fail-closed behaviour of ADR-010,
# not a warning to be ignored.
#
# Blank OPENFGA_MODEL_ID resolves to "latest", which makes a deploy racy: a
# request in flight during a model deploy is evaluated against a model it was not
# written for. Pin it.
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# -----------------------------------------------------------------------------
# PII subject key cache
# -----------------------------------------------------------------------------
# Resolving one subject costs a PostgreSQL read, an OpenBao unwrap and a read of
# the sealed values. Caching the unwrapped KEY collapses the first two while
# leaving every byte of personal data sealed in PostgreSQL — nothing personal and
# no key material is ever sent to Valkey. What travels over Valkey is the
# invalidation: a SubjectID pseudonym meaning "forget that key".
#
# The TTL is a SECURITY window, not a performance knob. It is the longest an
# erased subject's key can still decrypt their data in a replica that never
# received the invalidation, so the app caps it at 5m and refuses to start above
# that. Raise it only with that sentence in mind.
PII_KEY_CACHE_TTL=1m
PII_KEY_CACHE_CAPACITY=4096
# How often expired keys are actually zeroed rather than merely treated as
# absent. Must not exceed the TTL.
PII_KEY_CACHE_SWEEP=15s

# -----------------------------------------------------------------------------
# Reactor dedup retention
# -----------------------------------------------------------------------------
# reactor_processed gains one row per event per reactor. The retention window
# must comfortably exceed the longest redelivery gap: a parked event replayed
# weeks later has to be recognised as already handled, or the reactor performs
# its effect a second time — a second charge, a second email. The app refuses to
# start below a 7-day floor.
REACTOR_DEDUP_RETENTION_DAYS=30
REACTOR_DEDUP_SWEEP_EVERY=1h

# -----------------------------------------------------------------------------
# Projector rebuild parallelism
# -----------------------------------------------------------------------------
# How many workers a REBUILD applies events through. 1 is sequential.
#
# Sharding partitions by STREAM, never by revision range: every event of one
# aggregate is applied in order by one worker. Slicing a link stream into
# revision ranges instead would let two events of the same aggregate land in
# different workers, and since every projection upserts by row the surviving row
# would be whichever committed last — wrong with no error anywhere.
#
# Each shard holds a pooled connection for the whole rebuild, so this must stay
# below POSTGRES_MAX_CONNS. The app refuses to start otherwise.
PROJECTOR_REBUILD_SHARDS=1

# How many events share ONE transaction while a projector is BEHIND the head of
# the log. 1 commits every event on its own.
#
# The round trip dominates catch-up and is paid per transaction, not per
# statement: measured 364.8 us/event unbatched against 16.7 us/event at 64.
# Atomicity is unchanged — the rows and the checkpoint describing them are still
# in the same transaction, so a crash loses the batch together and the projector
# reapplies it.
#
# It does NOT apply once a projector is live: there an event commits alone,
# because the delay between a write landing in the log and appearing in the read
# model is what matters.
PROJECTOR_CATCHUP_BATCH=64

# Paces a REBUILD, in events per second. 0 is unthrottled.
#
# A rebuild reads as fast as KurrentDB will serve and writes through the same
# PostgreSQL pool the API uses, so at full speed it is a load test against
# production run at the worst possible moment. Set this to make a rebuild a
# background job. It does not pace ordinary catch-up, where slowness just keeps
# every read stale for longer.
PROJECTOR_REBUILD_EVENTS_PER_SECOND=0

# How many realtime announcements may queue behind a projector.
#
# The queue exists so Centrifugo's latency stays out of the loop that advances
# the read model. When it fills, announcements are DROPPED — the row is already
# committed and a browser recovers by reading it — and counted in
# chronos_projection_announcements_dropped_total. A sustained non-zero rate
# there means the realtime path is failing while every row stays correct.
PROJECTOR_ANNOUNCE_BUFFER=256

# ---- Request pipeline -------------------------------------------------------
# How long a mutation's response stays replayable (CONVENTIONS §6). A RETENTION
# bound, not a cache hint: a stored response can carry personal data (ADR-002).
# Capped at 168h; the server refuses to boot above it.
API_IDEMPOTENCY_TTL=24h
# How often expired idempotency records are deleted.
API_IDEMPOTENCY_SWEEP_EVERY=1h
# How long a duplicate arriving mid-flight waits for the first request to
# finish. 0 does not wait, turning a double-click into an error the user sees.
API_IDEMPOTENCY_WAIT=5s

# How many proxies in front of this server APPEND to X-Forwarded-For. This is
# the trust boundary every per-caller rate limit is bucketed by.
#
# 0 — the default and the only value that is safe without knowing the topology —
# means the header is NOT READ AT ALL and the connection's peer address is used.
# Locally that is correct: nothing sits in front of cmd/api.
#
# SET IT TO THE NUMBER OF PROXIES THAT APPEND, AND NO MORE. Not a count of
# network devices, not a safety margin. Neither mistake has a runtime symptom and
# they are not symmetric:
#
#   too low  — every caller collapses into one bucket and the per-caller ceiling
#              silently becomes a global one (20 verification resends an hour for
#              the entire deployment). Users are refused at random. Not exploitable.
#   too high — the entry selected moves left, into the part of the header the
#              CALLER wrote. An attacker mints a fresh bucket per request to evade
#              the ceiling, or spoofs a victim's address to burn their budget.
#
# Direct or an L4 balancer that forwards TCP untouched: 0. One L7 ingress that
# terminates TLS: 1. CDN in front of that ingress, both appending: 2. Capped at
# 8; the server refuses to boot above it. See docs/INFRA.md §13.1.
API_TRUSTED_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# Identity — key material and the hashing bound
# -----------------------------------------------------------------------------
# Three 32-byte keys, hex-encoded (64 characters). Generate one with:
#
#   openssl rand -hex 32
#
# These are DEVELOPMENT values. They are committed so `make up` produces a
# working login on a fresh clone; a deployment that reuses them has published its
# password pepper, its TOTP sealing key and its email blind-index key.
#
# When they are absent, cmd/api logs at ERROR that identity could not be built
# and leaves IdentityService unregistered — the server runs, and registration,
# login and sessions do not exist. Outside APP_ENV=local that is a refusal to
# boot instead.

# Keys the blind index over email addresses. This one can NEVER be rotated: the
# index names a KurrentDB stream, stream names are immutable, and a new key
# orphans every reservation ever written — after which address uniqueness stops
# being enforced for everything registered before the change.
IDENTITY_EMAIL_INDEX_KEY=4f1f6f4b1c9d2a7e8b5c3d0e6a9f2b4c7d8e1a3f5b6c9d0e2a4f7b8c1d3e5a60

# The password pepper: the key the Argon2id verifier is sealed under, so a
# stolen database alone is not crackable offline (ADR-028).
IDENTITY_PASSWORD_PEPPER_KEY=9a3c5e7f1b4d6a8c0e2f4b6d8a0c2e4f6b8d0a2c4e6f8b0d2a4c6e8f0b2d4a6c
# The version new verifiers are sealed under, written beside each one. Must be
# at least 1: a row at version 0 is invisible to the rotation job's
# `pepper_version < n` query, so it is skipped silently and the account is
# locked out for good when the old key is destroyed.
IDENTITY_PASSWORD_PEPPER_VERSION=1

# Keys a PREVIOUS version sealed under, as `version:hex` pairs: `2:aabb…,1:ccdd…`.
# Empty is the normal state — one key, never rotated.
#
# Set this BEFORE deploying a new pepper. A verifier is sealed under the key of
# its own version, so a process holding only the new key cannot open any row the
# re-sealing job has not reached yet: every one of those users is locked out from
# the moment the new key ships. Rotation order is add-new-keep-old, let
# `chronos.identity.ResealCredentialKeys.v1` run until
# CountCredentialsAtKeyVersion reports zero, then drop the retired entry and
# destroy the key in OpenBao — in that order, because nothing in code enforces it.
IDENTITY_PASSWORD_PEPPER_RETIRED=

# Seals shared TOTP secrets, with the same rotation-visibility rule. NOTE: the
# re-sealing job does not exist yet, so rotating this key today strands every
# TOTP secret under a key the operational rule says may be destroyed.
IDENTITY_TOTP_SEAL_KEY=2c4e6a8f0b1d3e5a7c9f1b3d5e7a9c0f2b4d6e8a1c3f5b7d9e0a2c4f6b8d0e2a
IDENTITY_TOTP_SEAL_KEY_VERSION=1

# The same list for the TOTP sealing key, same format, same order of operations.
# The failure here is worse than for passwords: a secret nobody can open is a
# second factor the user can never satisfy, and there is no reset flow behind it.
IDENTITY_TOTP_SEAL_RETIRED=

# The label a user sees above the account in their authenticator app.
IDENTITY_TOTP_ISSUER=Chronos

# How many Argon2id hashes may run at once. Each holds 32 MiB for its whole
# duration, so this is the memory ceiling on password verification no matter how
# many attempts arrive — the supply-side half of the pair of controls that keep
# login from being a memory amplification vector.
#
# 0 means "resolve from the CPU limit this process actually has": cmd/api reads
# the cgroup CPU quota, because GOMAXPROCS reports the HOST's core count under a
# CFS quota and would size this several times too high in a container. Set it
# explicitly only from a measurement on the target hardware — throughput
# saturates at the core count and declines beyond it. Capped at 256.
IDENTITY_PASSWORD_HASH_CONCURRENCY=0

# ---------------------------------------------------------------------------
# Stripe — provisioning only, for now
# ---------------------------------------------------------------------------
# What these buy: an organization becomes usable. Without them every
# organization created stays in `provisioning`, which permits reading and
# billing and nothing else — no workspace, no invitations, a signup that never
# completes. cmd/worker says so at startup.
#
# Use a RESTRICTED key (rk_test_...), not a secret key. A restricted key is
# scoped to the resources this integration touches, so a leak cannot read every
# charge the account has ever taken.
#
# A LIVE key outside APP_ENV=production FAILS STARTUP (ADR-008, billing.md §5
# case 20). Stripe distinguishes test from live by prefix and nothing else —
# same code path, same API, real money — so a live key here would not misbehave,
# it would work, and charge real cards while every test passed.
STRIPE_SECRET_KEY=

# There is NO trial price id and NO trial length here any more.
#
# Both were variables until the plan catalogue landed. They are now
# internal/modules/billing/domain.Published(), which cmd/worker mirrors into
# Stripe at startup: the Products and Prices are created if absent and found by
# lookup key if present, so a fresh test account needs nothing set up by hand.
#
# A price id in configuration is a number that can differ between two
# deployments of the same binary, which makes "what did this customer sign up
# to" unanswerable across environments. A trial length held apart from the
# Price it applies to is how a fourteen-day plan ends up running for thirty.
# To change either, edit the catalogue and ship a new plan version.

# The webhook signing secret. Without it the endpoint REFUSES to be served, and
# the API says so loudly at startup — an endpoint that accepted unverified
# events would be an unauthenticated way to suspend a tenant.
#
# For local development, `stripe listen` prints one and holds the tunnel open:
#
#   stripe listen --forward-to localhost:8090/stripe/webhook
#
# Port 8090 is API_PORT; 8080 belongs to OpenFGA.
STRIPE_WEBHOOK_SECRET=

# The secret being rotated OUT. Both are accepted while a rotation is in flight
# (billing.md §5 case 26), so no event is dropped between updating Stripe and
# restarting the process.
STRIPE_WEBHOOK_SECRET_PREVIOUS=

# The relying-party id passkeys are bound to (ADR-057). The registrable domain,
# no scheme and no port.
#
# It is BOUND INTO every credential at registration and cannot be changed
# afterwards: a passkey made for `chronos.example` will not authenticate against
# `app.chronos.example`, and every existing passkey stops working the day this
# moves. There is deliberately no default — a default is a value somebody
# deploys without noticing, and noticing later costs every passkey in the
# installation.
#
# Unset means the passkey endpoints are NOT served. That is the intended way to
# run without them.
IDENTITY_WEBAUTHN_RP_ID=localhost

# What the authenticator shows while somebody approves. Display-only.
IDENTITY_WEBAUTHN_RP_DISPLAY_NAME=Chronos

# The environment segment every API key this deployment mints carries:
#   chr_<env>_<key id>_<secret>          (identity.md §10)
#
# It is bound into the DIGEST, so a token minted here hashes to a value no other
# environment.s table contains — which is what stops a staging credential, from a
# system with weaker access controls, working against production. Set it to
# something that names THIS deployment: live, test, staging, dev.
#
# There is deliberately no default, for the reason IDENTITY_WEBAUTHN_RP_ID has
# none: a default would be the same value everywhere, which removes exactly the
# separation the segment exists to create.
#
# Unset means the four key-management endpoints are NOT served — they answer
# NOT_FOUND naming this variable. Listing existing keys and authenticating with
# one already minted keep working, because neither needs to know the name.
#
# Lower-case alphanumeric, at most 16 characters. An underscore would add a
# segment and make every token this deployment mints unparseable.
IDENTITY_API_KEY_ENVIRONMENT=dev

# Full origins a ceremony may come from, scheme and port included, comma
# separated. The origin check is what makes a credential unusable from an
# attacker's page. Empty is refused rather than defaulted.
IDENTITY_WEBAUTHN_ORIGINS=http://localhost:3000,http://localhost:8090


# ---------------------------------------------------------------------------
# The operator plane — the back office (ADR-024, docs/domains/operator.md)
# ---------------------------------------------------------------------------
#
# `cmd/operator` is the only thing in this system that deliberately breaks
# tenant isolation, and it runs on its own port, on an internal network, as its
# own database role. It REFUSES to start misconfigured rather than degrading —
# an operator plane serving the cross-tenant surface with a guard missing is
# worse than one that is down.

OPERATOR_ADDR=:8095

# Sign-in is SSO-then-WebAuthn, in that order, with no password and no TOTP
# fallback (operator.md §3). Both halves are required: without the IdP there is
# no way in at all, and without the relying party the second factor cannot be
# presented.
#
# In dev these can point at the same Google client identity already uses. In
# production they must not — the operator console is a different application
# with a different redirect URI and a different consent screen.
OPERATOR_OIDC_ISSUER=https://accounts.google.com
OPERATOR_OIDC_CLIENT_ID=
OPERATOR_OIDC_CLIENT_SECRET=
OPERATOR_OIDC_REDIRECT_URL=http://localhost:8095/operator/callback

# Pins a Google Workspace domain, so a personal account at the same provider is
# refused BEFORE the operator lookup. Belt and braces with operator_account,
# which is the actual authority — but this one fails earlier and cheaper.
OPERATOR_HOSTED_DOMAIN=

# The WebAuthn relying party. DELIBERATELY NOT the tenant app's.
#
# The RP ID is bound into every credential at registration, so sharing it with
# the product would make a tenant's passkey presentable to the back office. A
# separate one means a tenant credential is not merely unauthorized here — it
# cannot be asserted at all.
OPERATOR_WEBAUTHN_RP_ID=localhost
OPERATOR_WEBAUTHN_RP_DISPLAY_NAME=Chronos Operations
OPERATOR_WEBAUTHN_ORIGINS=http://localhost:8095

# The internal ranges operator access is restricted to, as comma-separated
# CIDRs. A malformed entry is a startup failure rather than a skipped one:
# skipping would narrow the permitted set silently, or — if it were the only
# entry — widen it to everything.
OPERATOR_ALLOWED_NETWORKS=127.0.0.0/8,::1/128

# Makes an EMPTY OPERATOR_ALLOWED_NETWORKS mean "anywhere".
#
# It exists so the permissive case has to be ASKED FOR. Without it, a missing
# OPERATOR_ALLOWED_NETWORKS would serve the cross-tenant plane to every network,
# and "configured to allow all" would be indistinguishable from "nobody
# configured it".
OPERATOR_ALLOW_ANY_IP=false
